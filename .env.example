OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CONTEXT_WINDOW=128000
DATABASE_URL=replace-with-external-postgresql-url
# Use require for an external database URL with a verifiable certificate.
# The Render Blueprint injects an internal private-network URL and leaves this unset.
DATABASE_SSL=require
# Optional: trusted PEM CA certificate if the database does not use a public CA.
DATABASE_CA_CERT=
DEMO_ACCESS_CODE=replace-with-a-shared-demo-code
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
USDA_FDC_API_KEY=replace-with-your-data-gov-api-key
